    "statusBar.noFolderBackground": "#0A201D",
    "statusBarItem.hoverBackground": "#145A53",
    "statusBarItem.remoteBackground": "#007F70",
    "statusBarItem.remoteForeground": "#F0FFFC",
    "titleBar.activeBackground": "#071312",
    "titleBar.activeForeground": "#DCEAE8",
    "titleBar.inactiveBackground": "#081715",
    "titleBar.inactiveForeground": "#66817C",
    "activityBar.background": "#081715",
