    "list.activeSelectionForeground": "#F0FFFC",
    "list.inactiveSelectionBackground": "#103530",
    "list.hoverBackground": "#0E2B27",
    "list.highlightForeground": "#72E6FF",
    "list.focusOutline": "#00E5C3",
