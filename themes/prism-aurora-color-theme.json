  "tokenColors": [
    {"name":"Comments","scope":["comment","punctuation.definition.comment"],"settings":{"foreground":"#66817C","fontStyle":"italic"}},
    {"name":"Keywords and storage","scope":["keyword","keyword.control","keyword.operator.new","keyword.operator.expression","storage","storage.type","storage.modifier"],"settings":{"foreground":"#00E5C3"}},
    {"name":"Constants and numbers","scope":["constant","constant.numeric","constant.language","constant.character"],"settings":{"foreground":"#F4D47C"}},
    {"name":"Strings","scope":["string","string.quoted","string.template","punctuation.definition.string"],"settings":{"foreground":"#A7F3D0"}},
    {"name":"Functions","scope":["entity.name.function","support.function","meta.function-call"],"settings":{"foreground":"#72E6FF"}},
    {"name":"Types and classes","scope":["entity.name.type","entity.name.class","support.type","support.class","entity.other.inherited-class"],"settings":{"foreground":"#C4A7FF"}},
    {"name":"Variables","scope":["variable","variable.other","meta.definition.variable"],"settings":{"foreground":"#DCEAE8"}},
    {"name":"Parameters","scope":["variable.parameter","meta.function.parameters"],"settings":{"foreground":"#FFB6A6","fontStyle":"italic"}},
    {"name":"Properties","scope":["variable.other.property","meta.object-literal.key","support.type.property-name"],"settings":{"foreground":"#72E6FF"}},
    {"name":"Operators","scope":["keyword.operator","punctuation.separator","punctuation.accessor"],"settings":{"foreground":"#8DD8CF"}},
    {"name":"Punctuation","scope":["punctuation","meta.brace"],"settings":{"foreground":"#91AAA7"}},
    {"name":"Tags","scope":["entity.name.tag","support.class.component"],"settings":{"foreground":"#FF8F9C"}},
    {"name":"Attributes","scope":["entity.other.attribute-name"],"settings":{"foreground":"#F4D47C"}},
    {"name":"Invalid","scope":["invalid","invalid.illegal"],"settings":{"foreground":"#071312","background":"#FF8F9C"}},
    {"name":"Markdown headings","scope":["markup.heading","entity.name.section"],"settings":{"foreground":"#72E6FF","fontStyle":"bold"}},
    {"name":"Markdown bold","scope":["markup.bold"],"settings":{"foreground":"#A7F3D0","fontStyle":"bold"}},
    {"name":"Markdown italic","scope":["markup.italic"],"settings":{"foreground":"#C4A7FF","fontStyle":"italic"}},
    {"name":"Markdown links","scope":["markup.underline.link","string.other.link"],"settings":{"foreground":"#72E6FF","fontStyle":"underline"}},
    {"name":"Diff additions","scope":["markup.inserted"],"settings":{"foreground":"#A7F3D0"}},
    {"name":"Diff deletions","scope":["markup.deleted"],"settings":{"foreground":"#FF8F9C"}},
    {"name":"Diff changes","scope":["markup.changed"],"settings":{"foreground":"#F4D47C"}}
  ],
  "semanticTokenColors": {
    "namespace": "#C4A7FF",
    "type": "#C4A7FF",
    "class": "#C4A7FF",
    "enum": "#C4A7FF",
    "interface": "#72E6FF",
    "struct": "#72E6FF",
    "typeParameter": "#FFB6A6",
    "parameter": {"foreground":"#FFB6A6","italic":true},
    "variable": "#DCEAE8",
    "property": "#72E6FF",
    "enumMember": "#F4D47C",
    "function": "#72E6FF",
    "method": "#72E6FF",
    "macro": "#00E5C3",
    "keyword": "#00E5C3",
    "comment": {"foreground":"#66817C","italic":true},
    "string": "#A7F3D0",
    "number": "#F4D47C",
    "regexp": "#FF8F9C",
    "operator": "#8DD8CF",
    "decorator": "#FF8F9C"
  }
}
